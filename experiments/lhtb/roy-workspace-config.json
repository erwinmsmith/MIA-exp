{
  "version": 15,
  "traceEvents": true,
  "memoryUpdates": "off",
  "llm": {
    "streamMaxAttempts": 3,
    "streamContinuationMaxSegments": 4,
    "jsonMaxAttempts": 2,
    "turnMaxAttempts": 3,
    "retryInitialDelayMs": 250,
    "retryMaxDelayMs": 2000
  },
  "delegation": {
    "enabled": true,
    "mode": "auto",
    "maxChildrenPerParent": 8,
    "maxDepth": 5,
    "maxTotalAgentsPerTurn": 24,
    "rootSteps": {
      "enabled": true,
      "maxStepsPerTurn": 18,
      "maxDelegationRounds": 6,
      "reassessAfterDelegation": true,
      "maxWallClockMs": 3300000,
      "maxStalledIterations": 3,
      "persistEveryStep": true,
      "cacheExecutionKnowledge": true,
      "teamFirstLongHorizon": true,
      "maxCachedSteps": 300,
      "maxFeedbackItemsInPrompt": 32,
      "maxExecutionClosureAttempts": 4,
      "directDecisionAuditMinObligations": 4,
      "maxExploratoryDelegationRounds": 2,
      "executionReserveMs": 1200000,
      "finalizationReserveMs": 180000,
      "requireAcceptanceAudit": true
    }
  },
  "context": {
    "sessionWindowTurns": 30,
    "maxContextTokens": 32000,
    "includeToolResults": "summary",
    "includeSubagentReports": "summary",
    "includePrivateMemory": true,
    "includePublicMemory": true
  },
  "budgetMarket": {
    "mode": "unlimited",
    "defaultRequestsByArchetype": {
      "root": 200000,
      "researcher": 120000,
      "critic": 80000,
      "planner": 80000,
      "coder": 200000,
      "summarizer": 64000,
      "tester": 120000,
      "custom": 120000,
      "team_synthesis": 80000
    }
  },
  "tools": {
    "approval": {
      "readOnly": "auto",
      "write": "auto",
      "execute": "auto",
      "overrides": {}
    },
    "shell": {
      "mode": "unrestricted",
      "shell": "/bin/sh",
      "defaultTimeoutMs": 180000,
      "maxTimeoutMs": 600000,
      "defaultMaxOutputBytes": 120000,
      "maxCallsPerAgent": 500
    },
    "executionLoop": {
      "enabled": true,
      "maxRounds": 36,
      "maxCallsPerRun": 64,
      "maxConsecutiveFailures": 5,
      "maxWallClockMs": 1800000,
      "maxFetchesAfterSearch": 4,
      "llmReplanning": true
    }
  }
}
