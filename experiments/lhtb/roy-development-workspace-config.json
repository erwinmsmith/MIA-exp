{
  "version": 1,
  "traceEvents": true,
  "memoryUpdates": "off",
  "delegation": {
    "enabled": true,
    "mode": "auto",
    "maxChildrenPerParent": 8,
    "maxDepth": 5,
    "maxTotalAgentsPerTurn": 24,
    "rootSteps": {
      "enabled": true,
      "maxStepsPerTurn": 24,
      "maxDelegationRounds": 8,
      "reassessAfterDelegation": true,
      "maxWallClockMs": 10800000,
      "maxStalledIterations": 4,
      "persistEveryStep": true,
      "cacheExecutionKnowledge": true,
      "teamFirstLongHorizon": true,
      "maxCachedSteps": 500,
      "maxFeedbackItemsInPrompt": 48,
      "maxExecutionClosureAttempts": 8,
      "directDecisionAuditMinObligations": 4,
      "maxExploratoryDelegationRounds": 2,
      "executionReserveMs": 7200000,
      "finalizationReserveMs": 300000,
      "requireAcceptanceAudit": true
    }
  },
  "context": {
    "sessionWindowTurns": 30,
    "maxContextTokens": 32000,
    "includeToolResults": "summary",
    "includeSubagentReports": "summary",
    "includePrivateMemory": true,
    "includePublicMemory": true
  },
  "budgetMarket": {
    "mode": "unlimited",
    "defaultRequestsByArchetype": {
      "root": 200000,
      "researcher": 120000,
      "critic": 80000,
      "planner": 80000,
      "coder": 200000,
      "summarizer": 64000,
      "tester": 120000,
      "custom": 120000,
      "team_synthesis": 80000
    }
  },
  "tools": {
    "approval": {
      "readOnly": "auto",
      "write": "auto",
      "execute": "auto",
      "overrides": {}
    },
    "shell": {
      "mode": "unrestricted",
      "shell": "/bin/sh",
      "defaultTimeoutMs": 300000,
      "maxTimeoutMs": 1800000,
      "defaultMaxOutputBytes": 160000,
      "maxCallsPerAgent": 1000
    },
    "executionLoop": {
      "enabled": true,
      "maxRounds": 72,
      "maxCallsPerRun": 128,
      "maxConsecutiveFailures": 8,
      "maxWallClockMs": 7200000,
      "maxFetchesAfterSearch": 4,
      "llmReplanning": true
    }
  }
}
