{
  "schemaVersion": 1,
  "scoreContract": {
    "range": [0.0, 1.0],
    "formula": "earned / possible",
    "requiredItemFields": [
      "metric",
      "earned",
      "possible",
      "score",
      "exactMatch",
      "parsed"
    ],
    "requiredRunFields": [
      "score",
      "meanItemScore",
      "exactMatchRate",
      "parseRate"
    ],
    "crossBenchmarkAggregation": "macro mean of each benchmark's normalized score",
    "samplingMetrics": {
      "passAtK": "mean per-task unbiased probability of at least one score meeting the benchmark success threshold in k attempts",
      "requiredK": [1, 5],
      "insufficientAttempts": null
    }
  },
